<mxfile host="Electron" agent="generate_shared_terraform_modules.py" version="24.7.17">
  <diagram id="page-release" name="release flow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1192" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="How a shared module is released and consumed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Every module repository works the same way: pull requests land on dev, a maintainer promotes dev to main in one reviewed pull request, release-please versions and tags from main, and callers pin a tag — never a branch." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1354" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="1 · Change — pull requests into dev, from people and from AI agents alike" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FBFCFD;strokeColor=#232F3E;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#232F3E;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1574" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;1 · Branch from dev&lt;/b&gt;&lt;br&gt;feat/… fix/… docs/… chore/…&lt;br&gt;hours or days, then deleted" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;2 · Pull request into dev&lt;/b&gt;&lt;br&gt;Title is a Conventional Commit:&lt;br&gt;fix: · feat: · feat!:" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="316" y="140" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;3 · CI&lt;/b&gt;&lt;br&gt;ci / CI passed — the only&lt;br&gt;required status check" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="572" y="140" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;4 · Review&lt;/b&gt;&lt;br&gt;One approval from someone else;&lt;br&gt;an agent cannot approve its own" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="828" y="140" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;5 · Squash merge into dev&lt;/b&gt;&lt;br&gt;The title becomes the commit;&lt;br&gt;the branch is deleted" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1084" y="140" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;6 · dev accumulates&lt;/b&gt;&lt;br&gt;Integration: CI on every push;&lt;br&gt;nothing here is released yet" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="140" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c5" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c8" target="c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c9" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="Agents (Copilot, Claude, Codex) open pull requests into dev only. The requester's approval of an agent's pull request does not count, stale approvals are dismissed on push, and the most recent push must be approved by someone other than the person who pushed it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="216" width="1534" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="2 · Promote and release — one squash into main, then release-please" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FBFCFD;strokeColor=#232F3E;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#232F3E;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1574" height="440" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;7 · scripts/promote.sh&lt;/b&gt;&lt;br&gt;Refuses while dev is behind main;&lt;br&gt;builds the description" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="176" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;8 · Promotion pull request&lt;/b&gt;&lt;br&gt;chore(promote): dev to main —&lt;br&gt;the description lists every change" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="252" y="340" width="176" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;9 · CI + human approval&lt;/b&gt;&lt;br&gt;ci / CI passed, branch up to date;&lt;br&gt;one approval  &lt;font color='#DD344C'&gt;&lt;b&gt;HITL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="444" y="340" width="176" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;b&gt;10 · Squash merge into main&lt;/b&gt;&lt;br&gt;One commit; its body is what&lt;br&gt;release-please reads" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="636" y="340" width="176" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;b&gt;11 · Release pull request&lt;/b&gt;&lt;br&gt;release-please opens or updates&lt;br&gt;chore(main): release X.Y.Z" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="828" y="340" width="176" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;12 · Merge the release PR&lt;/b&gt;&lt;br&gt;A human decides when&lt;br&gt;to release  &lt;font color='#DD344C'&gt;&lt;b&gt;HITL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="340" width="176" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;b&gt;13 · Tag vX.Y.Z + Release&lt;/b&gt;&lt;br&gt;Created by the release App;&lt;br&gt;immutable; traceable to main" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1212" y="340" width="176" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;14 · Sync dev with main&lt;/b&gt;&lt;br&gt;The release workflow merges&lt;br&gt;main back into dev" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1404" y="340" width="176" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c18" target="c19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c19" target="c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c20" target="c21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c21" target="c22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c22" target="c23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c23" target="c24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c24" target="c25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="dev always contains main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;dashed=1;strokeColor=#147EBA;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c10">
          <mxGeometry x="-0.3" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1492" y="290" />
              <mxPoint x="1458" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c34" value="&lt;b&gt;Why the promotion is a squash&lt;/b&gt;&lt;br&gt;release-please reads main's history in commit-date order and stops at the first commit equal to the last release. A merge commit would keep dev's commits with their original dates, so any of them older than the last release commit would be skipped, silently (googleapis/release-please #1533, #2883). One squash commit whose description lists every change is read in full." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="290" height="196" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="&lt;b&gt;The promotion description&lt;/b&gt;&lt;br&gt;&lt;font face='monospace'&gt;chore(promote): dev to main (#42)&lt;br&gt;&lt;br&gt;feat(aurora): add scaling (#10)&lt;br&gt;&lt;br&gt;fix(vpc): correct the NAT route (#11)&lt;br&gt;BREAKING CHANGE: route ids renamed&lt;br&gt;&lt;br&gt;feat: add the sns module (#1)&lt;br&gt;Release-As: 1.0.0&lt;/font&gt;&lt;br&gt;One header per line at column 0, footers under their change, no bullets: that is what release-please parses as separate changes." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="368" y="440" width="290" height="196" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;Version from the commit types&lt;/b&gt;&lt;br&gt;• fix: → patch (1.0.1)&lt;br&gt;• feat: → minor (1.1.0)&lt;br&gt;• feat!: or BREAKING CHANGE → major (2.0.0)&lt;br&gt;• docs:, chore:, refactor:, test:, ci: → no release&lt;br&gt;The first release carries Release-As: 1.0.0 from the pull request into dev, through the promotion, to main." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="676" y="440" width="290" height="196" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="&lt;b&gt;Rulesets&lt;/b&gt; (stored in rulesets/; enforced when the plan allows — see Branching and governance)&lt;br&gt;• dev — pull request, 1 approval, last-push approval, conversations resolved, ci / CI passed, squash only, no deletion or force-push&lt;br&gt;• main — the same plus code-owner review, an up-to-date branch and linear history&lt;br&gt;• tags v* — creation, update and deletion blocked; the release App is the only bypass" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="984" y="440" width="290" height="196" as="geometry" />
        </mxCell>
        <mxCell id="c38" value="&lt;b&gt;Tokens&lt;/b&gt;&lt;br&gt;• CI runs on GITHUB_TOKEN with contents: read&lt;br&gt;• release-please and the sync run as the release App (Contents, Pull requests, Issues), minted per job: a pull request opened with GITHUB_TOKEN would never trigger CI&lt;br&gt;• target-branch: main is explicit; the job runs only for refs/heads/main&lt;br&gt;• no cloud credentials anywhere: the tests mock the provider" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1292" y="440" width="290" height="196" as="geometry" />
        </mxCell>
        <mxCell id="c39" value="Repositories that release nothing (such as alxnderia-infrastructure) promote dev to main with a merge commit instead: nothing constrains the merge method and no sync is needed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="652" width="1534" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c40" value="3 · Consume — in a caller such as alxnderia-infrastructure" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FBFCFD;strokeColor=#232F3E;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#232F3E;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1574" height="380" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="&lt;b&gt;Release vX.Y.Z&lt;/b&gt;&lt;br&gt;a tag in terraform-aws-{module}" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c42" value="&lt;b&gt;Pin the tag in the caller&lt;/b&gt;&lt;br&gt;&lt;font face='monospace'&gt;module &quot;vpc&quot; {&lt;br&gt;  source = &quot;git::https://github.com/{org}/terraform-aws-vpc.git?ref=v1.2.0&quot;&lt;br&gt;}&lt;/font&gt;&lt;br&gt;Never ?ref=main or ?ref=dev: a caller changes only when its own pull request says so." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="802" width="490" height="92" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="&lt;b&gt;terraform init&lt;/b&gt;&lt;br&gt;downloads exactly that tag; the caller's lock file pins the providers" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="820" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;terraform plan&lt;/b&gt;&lt;br&gt;in the caller's pull request, reviewed like any other change" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="820" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c45" value="&lt;b&gt;terraform apply&lt;/b&gt;&lt;br&gt;from the reviewed plan, from the caller's main" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1350" y="820" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c41" target="c42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.17;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c43">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c43" target="c44">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c44" target="c45">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c50" value="&lt;b&gt;A newer release&lt;/b&gt;&lt;br&gt;vX.Y+1.0" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c51" value="&lt;b&gt;Dependabot&lt;/b&gt; (terraform ecosystem in the caller, target-branch: dev)&lt;br&gt;sees the newer tag and opens a pull request that changes ?ref=" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="1020" width="490" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#147EBA;" edge="1" parent="1" source="c50" target="c51">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c53" value="updates the pin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c51" target="c42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c54" value="&lt;b&gt;What a caller may rely on&lt;/b&gt;&lt;br&gt;• inputs, outputs and resource addresses change only in a major release&lt;br&gt;• a minor release adds optional inputs or outputs, with defaults that change nothing&lt;br&gt;• a patch release fixes behaviour without changing the interface" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="930" width="510" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c55" value="&lt;b&gt;Upgrading across a major version&lt;/b&gt;&lt;br&gt;Read the module's CHANGELOG and upgrade notes first: a major release can rename inputs or move resources, and the caller may need moved blocks of its own. Plan, compare, then apply — one module per pull request." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="1030" width="510" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c56" value="&lt;b&gt;Rolling back&lt;/b&gt;&lt;br&gt;Pin the previous tag again in a pull request; plan, then apply. Tags are immutable, so the previous version is exactly what it was." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1350" y="930" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c57" value="Source: terraform-module-standards: docs/standard.md §3, §6, §12, §13 · .github/workflows/terraform-release.yml · scripts/promote.sh · rulesets/*.json. Generated from the code as of the version this diagram was drawn for; edit the .drawio in draw.io and export the PNG beside it (File › Export as › PNG)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;fontSize=10;fontColor=#879196;" vertex="1" parent="1">
          <mxGeometry x="40" y="1152" width="1574" height="22" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-governance" name="governance">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="Branching and governance — who may do what, where" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Four kinds of ref, six kinds of actor. Blue: part of the model. Grey: not part of it. Red: never. &lt;font color='#DD344C'&gt;&lt;b&gt;HITL&lt;/b&gt;&lt;/font&gt; marks the two steps only a human takes. The rules are stored as rulesets; what GitHub enforces depends on the plan (bottom)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1354" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Short-lived branch&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="282" y="104" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;dev — integration&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="614" y="104" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;main — release&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="946" y="104" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Tags v* — releases&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1278" y="104" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Developer&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="144" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Creates, pushes, rebases and deletes: a workspace, no protection" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="282" y="144" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Pull request in; squash merge after ci / CI passed and someone else's approval" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="614" y="144" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="No direct push. A hotfix pull request only by exception, approved by a human, synced back to dev" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1F3F3;strokeColor=#5A6C86;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="946" y="144" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Never creates or moves a tag" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1278" y="144" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;AI coding agent&lt;br&gt;(Copilot, Claude, Codex)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="Creates and pushes its own branches (copilot/*, claude/*)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="282" y="240" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="Pull request in, like a person. Cannot approve it or merge it; its CI runs need a human's &quot;Approve and run&quot;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="614" y="240" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="Never: no promotion, no approval, no merge, no bypass, no change to rulesets, CODEOWNERS or release configuration" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="946" y="240" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="Never" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1278" y="240" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Maintainer (human)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="336" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="Same as a developer" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="282" y="336" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="Approves and merges other people's and agents' pull requests" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="614" y="336" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="Runs scripts/promote.sh; a different human approves the promotion &lt;font color='#DD344C'&gt;&lt;b&gt;HITL&lt;/b&gt;&lt;/font&gt;; merges the release pull request &lt;font color='#DD344C'&gt;&lt;b&gt;HITL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="946" y="336" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="Never by hand: release-please creates them" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1278" y="336" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;Release App&lt;br&gt;(terraform-bot-release)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="432" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="Its own release-please--branches--main" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="282" y="432" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="Pushes the main → dev sync after every push to main (bypass actor, always)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="614" y="432" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="Opens and updates the release pull request; never merges anything" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="946" y="432" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="Creates vX.Y.Z and the GitHub Release when the release pull request merges: the only bypass actor" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1278" y="432" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;Dependabot&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="528" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="dependabot/* branches" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="282" y="528" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="Version-update pull requests (target-branch: dev); merged like any other" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="614" y="528" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="Security-update pull requests only: GitHub always targets the default branch; the sync carries them to dev" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1F3F3;strokeColor=#5A6C86;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="946" y="528" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="Never" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1278" y="528" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="&lt;b&gt;GITHUB_TOKEN in CI&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="624" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="Reads contents, reports checks" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1F3F3;strokeColor=#5A6C86;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="282" y="624" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="Reads contents, reports checks" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1F3F3;strokeColor=#5A6C86;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="614" y="624" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="Reads contents, reports checks" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1F3F3;strokeColor=#5A6C86;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="946" y="624" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="Cannot create: contents: read" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1278" y="624" width="320" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c38" value="What the rulesets say (rulesets/dev.json, main.json, release-tags.json)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c39" value="&lt;b&gt;dev&lt;/b&gt;&lt;br&gt;• pull request required: 1 approval, stale approvals dismissed on push, approval of the most recent push, conversations resolved, squash only&lt;br&gt;• ci / CI passed (the branch need not be up to date)&lt;br&gt;• no deletion, no force-push&lt;br&gt;• bypass: the release App (always, for the sync push); organisation owners in pull-request mode while there is one maintainer" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="762" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;main&lt;/b&gt;&lt;br&gt;• pull request required: 1 approval, stale approvals dismissed, approval of the most recent push, code-owner review, conversations resolved, squash only&lt;br&gt;• ci / CI passed on an up-to-date branch&lt;br&gt;• linear history; no deletion, no force-push&lt;br&gt;• bypass: organisation owners in pull-request mode only; nobody pushes directly" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="577" y="762" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="&lt;b&gt;tags v*&lt;/b&gt;&lt;br&gt;• creation, update, deletion and force-push blocked&lt;br&gt;• bypass: the release App only, so release-please is the only thing that can create a release tag&lt;br&gt;• a tag ruleset cannot name the branch a commit must be on; restricting creation to the App, which runs only on main, has the same effect&lt;br&gt;• immutable releases lock the tag and the assets once published" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1114" y="762" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c42" value="&lt;b&gt;Enforced today?&lt;/b&gt;&lt;br&gt;GitHub Free with private repositories: the rulesets API refuses every ruleset, so the three cards above are stored intent and the model is procedural. Repository settings still enforce squash-only merges, pull-request title and body as the squash message, and branch deletion on merge. Public repositories on Free, or private ones on GitHub Team, enforce all three rulesets and CODEOWNERS review; push rulesets that protect .github/workflows/** need Team; &quot;require workflows to pass&quot; needs Enterprise; required reviewers on environments stay public-only below Enterprise." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF4EA;strokeColor=#D45B07;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="928" width="1574" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="Source: terraform-module-standards: docs/standard.md §3, §6, §12, §13 · .github/workflows/terraform-release.yml · scripts/promote.sh · rulesets/*.json. Generated from the code as of the version this diagram was drawn for; edit the .drawio in draw.io and export the PNG beside it (File › Export as › PNG)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;fontSize=10;fontColor=#879196;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="1574" height="22" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
